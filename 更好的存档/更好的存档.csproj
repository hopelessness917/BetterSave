<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Condition="!Exists('Directory.Build.props.user')" Project="Directory.Build.props.default" />
  <Import Condition=" Exists('Directory.Build.props.user')" Project="Directory.Build.props.user" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{D6169594-3B07-4C2C-B86B-9462C89814CC}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>SaveOpt</RootNamespace>
    <AssemblyName>更好的存档</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <GameLibsFolder Condition="'$(GameLibsFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameLibsFolder>
    <ModFolder Condition="'$(ModFolder)' == ''"></ModFolder>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <ModStaticID>BetterSave</ModStaticID>
    <ModTitle>更好的存档</ModTitle>
    <ModDescription>把存档时间理论提高70%</ModDescription>
    <ModVersion>2.10.0</ModVersion>
    <MinimumSupportedBuild>719533</MinimumSupportedBuild>
    <APIVersion>2</APIVersion>
    <SupportedContent>ALL</SupportedContent>
    <GeneratedVersionFile>$(MSBuildProjectDirectory)\Properties\ModVersion.g.cs</GeneratedVersionFile>
    <RepoModYaml>$(MSBuildProjectDirectory)\mod.yaml</RepoModYaml>
    <RepoModInfoYaml>$(MSBuildProjectDirectory)\mod_info.yaml</RepoModInfoYaml>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameLibsFolder)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLibsFolder)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameLibsFolder)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Ionic.Zip">
      <HintPath>$(GameLibsFolder)\Ionic.Zip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(GameLibsFolder)\FMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameLibsFolder)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLibsFolder)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibsFolder)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(GameLibsFolder)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PLib">
      <HintPath>libs\PLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="$(GeneratedVersionFile)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack" Version="2.0.48" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <TranslationFiles Include="translations\*.po" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="GenerateModVersion" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(GeneratedVersionFile)" Overwrite="true" Encoding="UTF-8"
      Lines="using System.Reflection%3B;[assembly: AssemblyVersion(&quot;$(ModVersion).0&quot;)];[assembly: AssemblyFileVersion(&quot;$(ModVersion).0&quot;)]" />
  </Target>
  <Target Name="GenerateModYaml" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="$(RepoModYaml)" Overwrite="true" Encoding="UTF-8"
      Lines="staticID: $(ModStaticID);description: &quot;$(ModDescription)&quot;;title: &quot;$(ModTitle)&quot;" />
    <WriteLinesToFile File="$(RepoModInfoYaml)" Overwrite="true" Encoding="UTF-8"
      Lines="APIVersion: $(APIVersion);minimumSupportedBuild: $(MinimumSupportedBuild);version: v$(ModVersion);supportedContent: $(SupportedContent)" />
  </Target>
  <Target Name="MergePLib" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_MergedDir>$(MSBuildProjectDirectory)\$(OutputPath)merged</_MergedDir>
      <_ILRepackExe>$(PkgILRepack)\tools\ILRepack.exe</_ILRepackExe>
      <_MainDll>$([System.IO.Path]::GetFullPath('$(TargetPath)'))</_MainDll>
      <_PLibDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\libs\PLib.dll'))</_PLibDll>
      <_OutDll>$([System.IO.Path]::GetFullPath('$(_MergedDir)\$(AssemblyName).dll'))</_OutDll>
      <_AbsOutputPath>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\'))</_AbsOutputPath>
      <_AbsGameLibs>$([System.IO.Path]::GetFullPath('$(GameLibsFolder)').TrimEnd('\'))</_AbsGameLibs>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ILRepackExe)')" Text="找不到 ILRepack.exe（$(PkgILRepack)）。请先用 msbuild /t:Restore 还原 NuGet 包。" />
    <Error Condition="!Exists('$(_PLibDll)')" Text="找不到 libs\PLib.dll。请从 https://github.com/peterhaneve/ONIMods/releases/tag/PLib4.25 下载官方 PLib 4.25 放进 libs\ 目录（许可证见 libs\PLib.LICENSE.txt）。" />
    <MakeDir Directories="$(_MergedDir)" />
    <Exec Command="&quot;$(_ILRepackExe)&quot; /out:&quot;$(_OutDll)&quot; /internalize /parallel &quot;$(_MainDll)&quot; &quot;$(_PLibDll)&quot; /lib:&quot;$(_AbsOutputPath)&quot; /lib:&quot;$(_AbsGameLibs)&quot;"
          WorkingDirectory="$(PkgILRepack)\tools" ConsoleToMSBuild="true" />
    <Message Importance="high" Text="已把 PLib 合并进 $(_OutDll)" />
  </Target>
  <Target Name="CopyModToGame" AfterTargets="MergePLib" Condition="'$(Configuration)' == 'Release' And '$(ModFolder)' != ''">
    <PropertyGroup>
      <_DeploySource Condition="Exists('$(MSBuildProjectDirectory)\$(OutputPath)merged\$(AssemblyName).dll')">$(MSBuildProjectDirectory)\$(OutputPath)merged\$(AssemblyName).dll</_DeploySource>
      <_DeploySource Condition="'$(_DeploySource)' == ''">$(TargetPath)</_DeploySource>
    </PropertyGroup>
    <Error Condition="!Exists('$(RepoModYaml)') Or !Exists('$(RepoModInfoYaml)')" Text="缺少 mod.yaml / mod_info.yaml（应由 GenerateModYaml 生成）。" />
    <MakeDir Directories="$(ModFolder)" />
    <Copy SourceFiles="$(_DeploySource)" DestinationFiles="$(ModFolder)\BetterSave.dll" />
    <Copy SourceFiles="$(RepoModYaml);$(RepoModInfoYaml)" DestinationFolder="$(ModFolder)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已部署 BetterSave.dll + mod.yaml + mod_info.yaml（版本 v$(ModVersion)）到 $(ModFolder)" />
    <Error Condition="'@(TranslationFiles)' == ''" Text="找不到 translations\*.po。缺了它们，模组选项面板会直接显示 STRINGS.* 原始键名（而不是中/英文案）。" />
    <MakeDir Directories="$(ModFolder)\translations" />
    <Copy SourceFiles="@(TranslationFiles)" DestinationFolder="$(ModFolder)\translations" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已部署 @(TranslationFiles->'%(Filename)%(Extension)', ' ') 到 $(ModFolder)\translations（缺了它们面板会显示原始键名）" />
  </Target>
</Project>
