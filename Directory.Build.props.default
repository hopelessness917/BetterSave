<?xml version="1.0" encoding="utf-8"?>
<!-- Instead of modifying this file, create a copy named Directory.Build.props.user and modify it to match the paths in your installation -->
<Project>
	<PropertyGroup>
		<!--Gamedata Folder, adjust to your own ONI installation-->
		<GameLibsFolder Condition="'$(OS)' != 'Unix'">S:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameLibsFolder>
		<GameLibsFolder Condition="'$(OS)' == 'Unix'">/mnt/Intel_Pestflatte/SteamLibrary/steamapps/common/OxygenNotIncluded/OxygenNotIncluded_Data/Managed</GameLibsFolder>
		
		<!--OutputModFolder, adjust it to your own dev folder-->
		<!-- 开发用 mods 目录，自动指向 文档\Klei\OxygenNotIncluded\mods\dev -->
		<DevModsFolder>Klei\OxygenNotIncluded\mods\dev</DevModsFolder>
		<ModFolder Condition="'$(OS)' != 'Unix'">D:\Documents\Klei\OxygenNotIncluded\mods\dev</ModFolder>
		<ModFolder Condition="'$(OS)' == 'Unix'">/mnt/Intel_Pestflatte/Klei/OxygenNotIncluded/mods/dev</ModFolder>
		<!--Default for dev folder: -->
		<!--<ModFolder>$(UserProfile)\Documents\Klei\OxygenNotIncluded\mods\dev</ModFolder>-->
		
		<!--Used to generate reference assemblies for GitHub CI; set this to 0 if you don't use automatic github builds and/or don't want to install Refasmer-->
		<RefasmerInstalled>1</RefasmerInstalled>
	</PropertyGroup>
	  <!-- 如果注册表中有“我的文档”路径，则覆盖 ModFolder -->
	<!-- 注意：DocumentsFolderRegistry 必须由外部逻辑赋值；否则这个 PropertyGroup 不会生效。 -->
	<PropertyGroup Condition=" '$(DocumentsFolderRegistry)' != '' ">
		<ModFolder>$(DocumentsFolderRegistry)\$(DevModsFolder)</ModFolder>
	</PropertyGroup>
</Project>